#!/usr/bin/env bash
# ncurrent — wrapper that delegates to the Python implementation

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
PYTHON_SCRIPTS_DIR="$PROJECT_DIR/python_scripts"
VENV_PYTHON="$PYTHON_SCRIPTS_DIR/venv/bin/python3"
NCURRENT_SCRIPT="$PYTHON_SCRIPTS_DIR/ncurrent.py"

if [ ! -f "$VENV_PYTHON" ]; then
    echo "Error: Virtual environment not found." >&2
    echo "Please run: $PYTHON_SCRIPTS_DIR/setup_venv.sh" >&2
    exit 1
fi

if [ ! -f "$NCURRENT_SCRIPT" ]; then
    echo "Error: ncurrent.py not found at $NCURRENT_SCRIPT" >&2
    exit 1
fi

exec "$VENV_PYTHON" "$NCURRENT_SCRIPT" "$@"
