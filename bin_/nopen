#!/usr/bin/env bash
#
# nopen - Wrapper to call Python nopen with venv

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
PYTHON_SCRIPTS_DIR="$PROJECT_DIR/python_scripts"
VENV_PYTHON="$PYTHON_SCRIPTS_DIR/venv/bin/python3"
NOPEN_SCRIPT="$PYTHON_SCRIPTS_DIR/nopen.py"

if [ ! -f "$VENV_PYTHON" ]; then
    echo "ERROR: Python virtual environment not found at $VENV_PYTHON" >&2
    echo "Run: cd $PYTHON_SCRIPTS_DIR && ./setup_venv.sh" >&2
    exit 1
fi

if [ ! -f "$NOPEN_SCRIPT" ]; then
    echo "ERROR: nopen.py not found at $NOPEN_SCRIPT" >&2
    exit 1
fi

exec "$VENV_PYTHON" "$NOPEN_SCRIPT" "$@"
